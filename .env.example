# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP API listens on (Render sets this automatically in production)
PORT=3000

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection URL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mailqueue
