# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets. All values below are placeholders.

# ---------- Shared (API + worker) ----------
# Runtime environment: development | test | production
NODE_ENV=development
# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection URL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://mailqueue:change_me@localhost:5432/mailqueue
# Use TLS for the database connection (true when connecting over the public internet)
DATABASE_SSL=false
# Maximum connections in the API's pool
DATABASE_POOL_MAX=10

# Retries after the first failed attempt (minimum 3) and the first retry delay in seconds.
# Each retry waits about twice as long as the previous one (exponential backoff).
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_SECONDS=10

# ---------- API only ----------
# Port the HTTP API listens on (Render sets PORT automatically)
PORT=3000
# Clients must send this in the X-API-Key header to use /emails (required in production,
# at least 16 characters). Generate one with:  node -e "console.log(crypto.randomUUID())"
API_KEY=replace-with-a-long-random-string

# ---------- Worker only ----------
# Resend API key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=re_your_resend_api_key
# Sender address. Without a verified domain, Resend only allows onboarding@resend.dev,
# and only delivers to the email address of your own Resend account.
EMAIL_FROM=MailQueue <onboarding@resend.dev>
# How many emails the worker sends in parallel
WORKER_CONCURRENCY=2

# ---------- Tests only ----------
# Separate database used ONLY by automated tests (tests delete its data!).
# Its name must end with _test.
TEST_DATABASE_URL=postgres://mailqueue:change_me@localhost:5432/mailqueue_test
